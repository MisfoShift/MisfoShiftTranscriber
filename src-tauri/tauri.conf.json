{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MisfoShiftTranscriber",
  "version": "0.1.0",
  "identifier": "com.misfoshift.transcriber",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MisfoShiftTranscriber", "width": 920, "height": 820, "minWidth": 680, "minHeight": 700, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 MisfoShift",
    "resources": ["../THIRD_PARTY_NOTICES.md"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
